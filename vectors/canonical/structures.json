          "y": {
            "x": 1,
            "w": 2
          },
          "a": [
            {
              "d": 1,
              "c": 2
            }
          ]
        },
        "a": 0
      },
      "expected": "{\"a\":0,\"z\":{\"a\":[{\"c\":2,\"d\":1}],\"y\":{\"w\":2,\"x\":1}}}",
      "sha256": "sha256:996f1cc75ec699bf1027f02c34833e6634f8e2df85b4946657f9ff82b16f6551"
    },
    {
      "name": "nested_arrays",
      "input": [
        [
          []
        ],
        [
          1,
          [
            2,
            [
              3,
              {
                "b": 1,
                "a": [
                  0.5,
                  -0.0
                ]
              }
            ]
          ]
        ],
        [],
        [
          [
            null,
            [
              true,
              [
                false
              ]
            ]
          ]
        ]
      ],
      "expected": "[[[]],[1,[2,[3,{\"a\":[0.5,0],\"b\":1}]]],[],[[null,[true,[false]]]]]",
      "sha256": "sha256:51539e4da44a08b1b347ffa12ee5a9a0c616fab0efed7078c4443c1a8eb8b470"
    },
    {
      "name": "string_escapes",
      "input": "\u0000\u0001\u0002\u0003\u0004\u0005\u0006\u0007\b\t\n\u000b\f\r\u000e\u000f\u0010\u0011\u0012\u0013\u0014\u0015\u0016\u0017\u0018\u0019\u001a\u001b\u001c\u001d\u001e\u001f\"\\/\u007f\u0080\u2028\u2029\ufeff\ud83d\ude00 end",
