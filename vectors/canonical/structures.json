{
  "format": "bounded-embodiment-vectors/canonical/1",
  "description": "RFC 8785 canonicalization of whole JSON values. Each case has 'input' (a JSON value) or 'input_json' (JSON text to parse strictly first), 'expected' (the canonical text) and 'sha256' (sha256 of the UTF-8 bytes of 'expected', in the sha256_jcs form). Object members sort by UTF-16 code units. Cross-checked against a Node.js reference. CC BY 4.0 (see REUSE.toml).",
  "cases": [
    {
      "name": "empty_object",
      "input": {},
      "expected": "{}",
      "sha256": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a"
    },
    {
      "name": "empty_array",
      "input": [],
      "expected": "[]",
      "sha256": "sha256:4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945"
    },
    {
      "name": "empty_string",
      "input": "",
      "expected": "\"\"",
      "sha256": "sha256:12ae32cb1ec02d01eda3581b127c1fee3b0dc53572ed6baf239721a03d82e126"
    },
    {
      "name": "literals",
      "input": [
        null,
        true,
        false
      ],
      "expected": "[null,true,false]",
      "sha256": "sha256:37257214f22b92121c5ff4d7e29ed2d31b3f1129ee698e96e581ec05cb2e3cf7"
    },
    {
      "name": "empty_containers_nested",
      "input": {
        "b": [],
        "a": {},
        "c": [
          {},
          []
        ]
      },
      "expected": "{\"a\":{},\"b\":[],\"c\":[{},[]]}",
      "sha256": "sha256:010b96c1533bb5ba7bcc83f5e2688860025e4c0e555490a9a1a1a7a18a32fb42"
    },
    {
      "name": "key_order_ascii",
      "input": {
        "b": 1,
        "a": 2,
        "c": 3
      },
      "expected": "{\"a\":2,\"b\":1,\"c\":3}",
      "sha256": "sha256:e145110e712e3ed0a6b233551b27a90aa39b4c93ed67e111ba2002d16e5ed1fa"
    },
    {
      "name": "key_order_case_and_punctuation",
      "input": {
        "a": 1,
        "B": 2,
        "_": 3,
        "0": 4,
        "": 5,
        "~": 6
      },
      "expected": "{\"\":5,\"0\":4,\"B\":2,\"_\":3,\"a\":1,\"~\":6}",
      "sha256": "sha256:33e4aa19c9cc6cacb289d4b26aa268ffe0909ecab4e4fb98f9f3a8698465b38e"
    },
    {
      "name": "key_order_prefixes",
      "input": {
        "aa": 1,
        "a": 2,
        "ab": 3,
        "b": 4,
        "a ": 5,
        "A": 6
      },
      "expected": "{\"A\":6,\"a\":2,\"a \":5,\"aa\":1,\"ab\":3,\"b\":4}",
      "sha256": "sha256:d48c7c321bae58b832330c5df4a5627afa80d3a2346d5eaec841b54bf3aa83a9"
    },
    {
      "name": "rfc8785_3_2_3_sorting",
      "input": {
        "\u20ac": "Euro Sign",
        "\r": "Carriage Return",
        "\ufb33": "Hebrew Letter Dalet With Dagesh",
        "1": "One",
        "\ud83d\ude00": "Emoji: Grinning Face",
        "\u0080": "Control",
        "\u00f6": "Latin Small Letter O With Diaeresis"
      },
      "expected": "{\"\\r\":\"Carriage Return\",\"1\":\"One\",\"\u0080\":\"Control\",\"\u00f6\":\"Latin Small Letter O With Diaeresis\",\"\u20ac\":\"Euro Sign\",\"\ud83d\ude00\":\"Emoji: Grinning Face\",\"\ufb33\":\"Hebrew Letter Dalet With Dagesh\"}",
      "sha256": "sha256:5e321556d22018a9656991a9e94f77ec175fa193e52a2429d312f8419ec8b08c"
    },
    {
      "name": "key_order_utf16_not_code_points",
      "description": "U+1F600 is above U+E000, U+FB33 and U+FFFF as a code point, but its UTF-16 lead unit 0xD83D sorts before all three.",
      "input": {
        "\u20ac": 1,
        "\ud83d\ude00": 2,
        "\ufb33": 3,
        "\ue000": 4,
        "\uffff": 5
      },
      "expected": "{\"\u20ac\":1,\"\ud83d\ude00\":2,\"\ue000\":4,\"\ufb33\":3,\"\uffff\":5}",
      "sha256": "sha256:a84b59bf71f42861a57838d32aa6f8d2fac0a8c5d52339b5f70ddda56287ba39"
    },
    {
      "name": "key_order_non_bmp_pairs",
      "input": {
        "\ud83d\ude00": 1,
        "\ud83d\udca9": 2,
        "\ud800\udc00": 3,
        "\udbff\udfff": 4,
        "\ud7ff": 5
      },
      "expected": "{\"\ud7ff\":5,\"\ud800\udc00\":3,\"\ud83d\udca9\":2,\"\ud83d\ude00\":1,\"\udbff\udfff\":4}",
      "sha256": "sha256:e900d9bd1ffeda78427c2795d5eb6c4306e52a39190052e9c0580474fb61e0f2"
    },
    {
      "name": "key_order_prefix_then_non_bmp",
      "input": {
        "a\uffff": 1,
        "a\ud83d\ude00": 2,
        "a": 3,
        "a\u20ac": 4
      },
      "expected": "{\"a\":3,\"a\u20ac\":4,\"a\ud83d\ude00\":2,\"a\uffff\":1}",
      "sha256": "sha256:761a38135248b0350e9d63993a0bc983ef63b119d348dd42481318fabe1740ab"
    },
    {
      "name": "no_unicode_normalization",
      "description": "Precomposed and decomposed forms are different member names; JCS does not normalize.",
      "input": {
        "\u00e9": "precomposed",
        "e\u0301": "decomposed"
      },
      "expected": "{\"e\u0301\":\"decomposed\",\"\u00e9\":\"precomposed\"}",
      "sha256": "sha256:c57984b0473441c370eb2a4c714ab07e698c13c59a816c319f421fc3fe3de928"
    },
    {
      "name": "nested_key_order",
